# Layer 1, shared: the vendor image under a name we control, plus field tools and jtop.
# Versions are repository variables (ultron.yml). BASE is a full tag; no dnf upgrade.
ARG BASE
FROM ${BASE}

# Lock every layer's dnf to the vendor image's release.
ARG RHEL_VERSION
RUN . /etc/os-release && \
    if [ "$VERSION_ID" != "${RHEL_VERSION:?RHEL_VERSION is not set}" ]; then \
        echo "RHEL_VERSION is $RHEL_VERSION, the base image is RHEL $VERSION_ID"; exit 1; fi && \
    mkdir -p /etc/dnf/vars && echo "$RHEL_VERSION" > /etc/dnf/vars/releasever

# nvidia-ctk.service needs the toolkit the vendor no longer ships.
ARG NVCTK_VER
RUN printf '%s\n' '[nvidia-container-toolkit]' 'name=nvidia-container-toolkit' \
        'baseurl=https://nvidia.github.io/libnvidia-container/stable/rpm/$basearch' \
        'gpgkey=https://nvidia.github.io/libnvidia-container/gpgkey' \
        'gpgcheck=1' 'repo_gpgcheck=1' > /etc/yum.repos.d/nvidia-container-toolkit.repo && \
    dnf install -y "nvidia-container-toolkit-base-${NVCTK_VER:?NVCTK_VER is not set}" && \
    rm /etc/yum.repos.d/nvidia-container-toolkit.repo && \
    dnf clean all

# A node has no repo and a read-only /usr: what a maintainer needs must be here.
# Some come with the vendor image, listed so a base bump cannot drop them.
# sysstat keeps RHEL's preset: sar logs to /var/log/sa every 10 min.
# python3-pip installs jtop below.
RUN dnf install -y --setopt=install_weak_deps=False \
        bind-utils ethtool lsof mtr NetworkManager-tui nmap-ncat pciutils psmisc \
        sos strace sysstat tcpdump tmux usbutils python3 python3-pip && \
    dnf clean all

# jtop (jetson-stats).
# --prefix=/usr: RHEL's own Python location; the unit below runs /usr/bin/jtop.
# --only-binary: the sdist's setup.py would install the unit and group itself.
# Group jtop: the service gives it its socket (0660) and will not start without it;
# members run jtop without root.
ARG JTOP_VER
RUN pip3 install --prefix=/usr --no-cache-dir --only-binary=:all: \
        "jetson-stats==${JTOP_VER:?JTOP_VER is not set}" && \
    groupadd -r jtop

# The wheel's unit template runs /usr/local/bin/jtop; root's first jtop installs it
# as is, and it never started (seen on hardware). Fix the path, and put the unit
# where jtop looks, so it never installs its own.
RUN unit=/usr/share/jetson_stats/jtop.service; \
    grep -q '^ExecStart=/usr/local/bin/jtop ' "$unit" || \
        { echo "unexpected ExecStart in $unit:"; grep ExecStart "$unit"; exit 1; }; \
    sed -i 's|^ExecStart=/usr/local/bin/jtop |ExecStart=/usr/bin/jtop |' "$unit" && \
    cp "$unit" /etc/systemd/system/jtop.service && \
    systemctl enable jtop.service

# jtop keeps its settings in sys.base_prefix (/usr) + /local/jtop, created on start:
# read-only on a node (EROFS, seen on hardware), so link it to /var. If /usr/local
# is a link into /var, this link lands in /var, which bootc never updates.
RUN [ -d /usr/local ] && [ ! -L /usr/local ] || \
        { echo "/usr/local is not a plain directory:"; ls -ld /usr/local; exit 1; }; \
    ln -s /var/lib/jtop /usr/local/jtop
COPY <<'EOF' /usr/lib/tmpfiles.d/jtop.conf
d /var/lib/jtop 0755 root root -
EOF

RUN bootc container lint
