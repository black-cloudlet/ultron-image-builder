# Layer 1, shared: the vendor image under a name we control, plus field tools.
# Pinned, never a floating tag — the Tegra kmod is tied to this kernel build.
# CVE fixes come from Red Hat's rebuilds, never dnf upgrade.
ARG BASE=registry.redhat.io/nvidia/nvidia-jetpack-for-rhel9:6.2.3_5.14.0-687.58.1_102226125727
FROM ${BASE}

# Every layer's dnf resolves against 9.8, the vendor's release. Without this a build
# takes RHEL's "9", the stream that moves to each new minor: 9.9 packages landed on
# the 9.8 base from 2026-11 (run 5). The builder's own release lock does not reach
# a build. Move it with the base tag.
RUN mkdir -p /etc/dnf/vars && echo 9.8 > /etc/dnf/vars/releasever

# The container toolkit, which the vendor dropped from its builds on 2026-09-03
# while still enabling nvidia-ctk.service, gated on /usr/bin/nvidia-ctk. NVIDIA's
# signed repo, the version the last vendor build with it carried; the repo file
# does not stay in the image. Its preset enables nvidia-cdi-refresh, as before.
ARG NVCTK_VER=1.20.0-1
RUN printf '%s\n' '[nvidia-container-toolkit]' 'name=nvidia-container-toolkit' \
        'baseurl=https://nvidia.github.io/libnvidia-container/stable/rpm/$basearch' \
        'gpgkey=https://nvidia.github.io/libnvidia-container/gpgkey' \
        'gpgcheck=1' 'repo_gpgcheck=1' > /etc/yum.repos.d/nvidia-container-toolkit.repo && \
    dnf install -y "nvidia-container-toolkit-base-${NVCTK_VER}" && \
    rm /etc/yum.repos.d/nvidia-container-toolkit.repo && \
    dnf clean all

# A node has no repo and a read-only /usr: what a maintainer needs must be here.
# Some come with the vendor image, listed so a base bump cannot drop them.
# sysstat keeps RHEL's preset: sar logs to /var/log/sa every 10 min.
RUN dnf install -y --setopt=install_weak_deps=False \
        bind-utils ethtool lsof mtr NetworkManager-tui nmap-ncat pciutils psmisc \
        sos strace sysstat tcpdump tmux usbutils && \
    dnf clean all

RUN bootc container lint
