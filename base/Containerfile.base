# Layer 1, shared: the vendor image under a name we control, plus field tools.
# Versions come from repository variables (ultron.yml); no defaults. BASE is a
# full tag: the Tegra kmod is tied to its kernel. No dnf upgrade.
ARG BASE
FROM ${BASE}

# Lock every layer's dnf to the vendor image's release; unlocked, a build follows
# the newest RHEL 9 minor.
ARG RHEL_VERSION
RUN . /etc/os-release && \
    if [ "$VERSION_ID" != "${RHEL_VERSION:?RHEL_VERSION is not set}" ]; then \
        echo "RHEL_VERSION is $RHEL_VERSION, the base image is RHEL $VERSION_ID"; exit 1; fi && \
    mkdir -p /etc/dnf/vars && echo "$RHEL_VERSION" > /etc/dnf/vars/releasever

# The vendor dropped the toolkit (2026-09) but still enables nvidia-ctk.service,
# which needs it. From NVIDIA's signed repo; the repo file is not kept.
ARG NVCTK_VER
RUN printf '%s\n' '[nvidia-container-toolkit]' 'name=nvidia-container-toolkit' \
        'baseurl=https://nvidia.github.io/libnvidia-container/stable/rpm/$basearch' \
        'gpgkey=https://nvidia.github.io/libnvidia-container/gpgkey' \
        'gpgcheck=1' 'repo_gpgcheck=1' > /etc/yum.repos.d/nvidia-container-toolkit.repo && \
    dnf install -y "nvidia-container-toolkit-base-${NVCTK_VER:?NVCTK_VER is not set}" && \
    rm /etc/yum.repos.d/nvidia-container-toolkit.repo && \
    dnf clean all

# A node has no repo and a read-only /usr: what a maintainer needs must be here.
# Some come with the vendor image, listed so a base bump cannot drop them.
# sysstat keeps RHEL's preset: sar logs to /var/log/sa every 10 min.
RUN dnf install -y --setopt=install_weak_deps=False \
        bind-utils ethtool lsof mtr NetworkManager-tui nmap-ncat pciutils psmisc \
        sos strace sysstat tcpdump tmux usbutils && \
    dnf clean all

RUN bootc container lint
